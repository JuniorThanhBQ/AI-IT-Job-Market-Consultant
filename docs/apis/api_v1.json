              ],
              "description": "Filter by seniority levels",
              "title": "Seniority"
            },
            "description": "Filter by seniority levels"
          },
          {
            "name": "working_model",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
