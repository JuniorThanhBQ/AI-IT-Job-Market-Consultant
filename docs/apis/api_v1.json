              ],
              "description": "Filter by working models",
              "title": "Working Model"
            },
            "description": "Filter by working models"
          },
          {
            "name": "min_salary",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by minimum salary",
              "title": "Min Salary"
            },
            "description": "Filter by minimum salary"
          },
          {
            "name": "max_salary",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
